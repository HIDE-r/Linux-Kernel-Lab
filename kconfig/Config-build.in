menu "Global build settings"
	config EXTERNAL_DL_DIR
		string "External download cache directory"
		default ""
		help
		  Optional absolute/relative path for downloaded source tarballs.
		  Relative paths are resolved from the project root (TOPDIR).
		  Leave empty to use default output/dl.

	config BUILD_QUIET
		bool "build quietly"
		default y
	config BUILD_COLOR_TTY
		bool "colorize build output if terminal supports it"
		default y
endmenu
